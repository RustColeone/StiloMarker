{
  "name": "sync",
  "level": 3,
  "uses": ["transport", "file_types", "workspace"],
  "owns": {
    "state": ["sessions", "presence", "leases", "event streams", "the rebase log"],
    "rules": ["rebasing a text patch", "who may send which change", "stale writes refused"],
    "names": ["sync protocol number"],
    "routes": ["/api/session/*", "/api/workspaces/open", "/api/operations", "/api/events/stream"]
  }
}
