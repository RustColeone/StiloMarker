{
  "name": "sync",
  "level": 4,
  "uses": ["transport", "file_types", "workspace", "identity", "projects"],
  "owns": {
    "state": ["the open workspaces", "session tokens", "sessions hosted for guests", "sessions", "presence", "leases", "event streams", "the rebase log"],
    "rules": ["rebasing a text patch", "who may send which change", "stale writes refused"],
    "names": ["sync protocol number"],
    "events": ["before-destructive", "paths-moved", "dropped"],
    "routes": ["/api/session/*", "/api/workspaces/open", "/api/operations", "/api/events/stream", "/api/workspaces/asset"]
  }
}
