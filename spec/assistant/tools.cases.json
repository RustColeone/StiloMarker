      "proposals": []
    },
    {
      "name": "edit_file, chained on its own proposal",
      "readOnly": false,
      "calls": [
        {
          "tool": "edit_file",
          "arguments": "{\"path\": \"notes.md\", \"edits\": [{\"find\": \"two\", \"replace\": \"2\"}]}",
          "result": {
            "status": "proposed",
            "proposalId": "op-1",
            "edits": 1
          }
        },
        {
          "tool": "edit_file",
          "arguments": "{\"path\": \"notes.md\", \"edits\": [{\"find\": \"One 2\", \"replace\": \"1, 2\"}]}",
          "result": {
            "status": "proposed",
            "proposalId": "op-2",
            "edits": 1
          }
        },
        {
          "tool": "edit_file",
          "arguments": "{\"path\": \"notes.md\", \"edits\": [{\"find\": \"two\", \"replace\": \"2\"}]}",
