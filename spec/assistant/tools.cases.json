{
  "about": "The workspace agent's tools, run against a project (rule 6): the server's (server/stilo/modules/assistant/service/tools.py, model/edits.py) and the browser's, for the agent it runs with the user's own key (app/modules/assistant/model/agent-tools.js). `edits`: edit_file's passages applied to a text (`expect`, or the `error` it says). `turns`: tool calls in order against `project`, each call's `arguments` as the model sends them (JSON text) and the `result` the model is given, and the proposals made; proposal ids are numbered op-1, op-2... in the order they first appear.",
  "project": {
    "id": "p",
    "name": "P",
    "rootId": "root",
    "nodes": {
      "root": {
        "id": "root",
        "kind": "folder",
        "name": "P",
        "parentId": null,
        "children": [
          "n",
          "c",
          "i"
        ]
      },
      "n": {
        "id": "n",
        "kind": "file",
        "parentId": "root",
        "name": "notes.md",
        "content": "# Notes\n\nOne two three. 你好 🌙 end."
      },
      "c": {
        "id": "c",
        "kind": "folder",
        "parentId": "root",
        "name": "chapters",
        "children": [
          "o"
        ]
      },
      "o": {
        "id": "o",
        "kind": "file",
        "parentId": "c",
        "name": "one.md",
        "content": "Chapter one."
      },
      "i": {
        "id": "i",
        "kind": "file",
        "parentId": "root",
        "name": "pic.png",
        "content": "data:image/png;base64,AAAA"
      }
    }
  },
  "edits": [
    {
      "name": "one passage",
      "text": "Hello world",
      "edits": [
        {
          "find": "world",
          "replace": "there"
        }
      ],
      "expect": "Hello there"
    },
    {
      "name": "an empty replace deletes",
      "text": "Hello cruel world",
      "edits": [
        {
          "find": "cruel ",
          "replace": ""
        }
      ],
      "expect": "Hello world"
    },
    {
      "name": "replace left out deletes too",
      "text": "Hello cruel world",
      "edits": [
        {
          "find": "cruel "
        }
      ],
      "expect": "Hello world"
    },
    {
      "name": "two passages, given in either order",
      "text": "a b c d",
      "edits": [
        {
          "find": "d",
          "replace": "D"
        },
        {
          "find": "a",
          "replace": "A"
        }
      ],
      "expect": "A b c D"
    },
    {
      "name": "text past the BMP (an emoji, CJK)",
      "text": "你好 🌙 end",
      "edits": [
        {
          "find": "🌙",
          "replace": "☀️"
        },
        {
          "find": "end",
          "replace": "fin"
        }
      ],
      "expect": "你好 ☀️ fin"
    },
    {
      "name": "a passage not there",
      "text": "Hello",
      "edits": [
        {
          "find": "bye",
          "replace": "x"
        }
      ],
      "error": "edit 1: find was not found; copy the passage exactly as the file has it (read_file first)"
    },
    {
      "name": "a passage there twice",
      "text": "la la land",
      "edits": [
        {
          "find": "la",
          "replace": "x"
        }
      ],
      "error": "edit 1: find matches 3 times; include more surrounding text so it matches once"
    },
    {
      "name": "overlapping occurrences count once",
      "text": "aaa",
      "edits": [
        {
          "find": "aa",
          "replace": "b"
        }
      ],
      "expect": "ba"
    },
    {
      "name": "overlapping edits",
      "text": "abcdef",
      "edits": [
        {
          "find": "abc",
          "replace": "x"
        },
        {
          "find": "cde",
          "replace": "y"
        }
      ],
      "error": "edits 1 and 2 overlap; merge them into one edit"
    },
    {
      "name": "an empty find",
      "text": "abc",
      "edits": [
        {
          "find": "",
          "replace": "x"
        }
      ],
      "error": "edit 1: find must be the exact text to change (not empty)"
    },
    {
      "name": "a replace that is not text",
      "text": "abc",
      "edits": [
        {
          "find": "a",
          "replace": 5
        }
      ],
      "error": "edit 1: replace must be text"
    },
    {
      "name": "an edit that is not an object",
      "text": "abc",
      "edits": [
        "a"
      ],
      "error": "edit 1 must be an object with find and replace"
    },
    {
      "name": "no edits",
      "text": "abc",
      "edits": [],
      "error": "edits must be a non-empty list of {find, replace}"
    },
    {
      "name": "edits that are not a list",
      "text": "abc",
      "edits": {
        "find": "a"
      },
      "error": "edits must be a non-empty list of {find, replace}"
    },
    {
