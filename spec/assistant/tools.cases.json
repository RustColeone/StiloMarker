  "turns": [
    {
      "name": "reading",
      "readOnly": false,
      "calls": [
        {
          "tool": "list_files",
          "arguments": "{}",
          "result": {
            "files": [
              {
                "path": "notes.md",
                "kind": "file"
              },
              {
                "path": "chapters",
                "kind": "folder"
              },
              {
                "path": "chapters/one.md",
                "kind": "file"
              },
              {
                "path": "pic.png",
                "kind": "file"
              }
            ]
          }
        },
        {
          "tool": "read_file",
          "arguments": "{\"path\": \"chapters/one.md\"}",
          "result": {
            "content": "Chapter one."
          }
        },
        {
          "tool": "read_file",
          "arguments": "{\"path\": \" notes.md \"}",
          "result": {
            "content": "# Notes\n\nOne two three. 你好 🌙 end."
          }
        },
        {
          "tool": "read_file",
          "arguments": "{\"path\": \"missing.md\"}",
          "result": {
            "error": "File not found: missing.md"
          }
        },
        {
          "tool": "read_file",
          "arguments": "{\"path\": \"chapters\"}",
          "result": {
            "error": "Not a file: chapters"
          }
