{
  "handles": ["aria", "old-hermit", "李白", "bram"],
  "cases": [
    {"text": "@old-hermit, then @aria. @aria again", "expect": ["old-hermit", "aria"]},
    {"text": "mail aria@ship.com or @bob", "expect": []},
    {"text": "(@ARIA) what now?", "expect": ["aria"]},
    {"text": "@李白 写首诗", "expect": ["李白"]},
