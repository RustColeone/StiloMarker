    {"text": "@everyone", "expect": ["aria", "old-hermit", "李白", "bram"]},
    {"text": "no mention here", "expect": []},
    {"text": "@aria-", "expect": ["aria"]},
    {"text": "@bram\n@aria", "expect": ["bram", "aria"]},
    {"text": "x@aria y_@bram .@aria", "expect": []},
    {"text": "“@aria” said", "expect": ["aria"]}
  ],
  "handleCases": [
    {"path": "a/b/Captain Aria.persona.skill", "expect": "captain-aria"},
    {"path": "李白.persona.skill", "expect": "李白"},
    {"path": "!!!.persona.skill", "expect": "character"},
    {"path": "Old  Hermit.persona.skill", "expect": "old-hermit"}
  ]
