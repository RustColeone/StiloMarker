{
  "name": "Stilo Marker",
  "short_name": "Stilo Marker",
  "description": "A Markdown workspace: notes, diagrams, characters, writing together.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "icons": [
    { "src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./assets/icons/stliomarker-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
