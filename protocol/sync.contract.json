{
  "about": "Sync's network messages (rule 7): joining a shared workspace, its state, presence, every change, the event stream that carries changes to everyone, and a folder workspace's images (served by path, uploaded in pieces). The server half serves exactly these routes (server/stilo/modules/sync/adapters/routes.py); only the browser half (app/modules/sync/adapters/api.js) calls them. `version` is the sync compatibility level: a browser sends it with every change (body `version`), and the server refuses an older one (426) so an out-of-date tab cannot write. Raise it only when old browsers must stop. Other modules' events ride the same stream; they are listed in their own contracts (and, until they move, in legacy.contract.json).",
  "module": "sync",
  "version": 117,
  "routes": [
    {
      "method": "POST",
      "path": "/api/session/connect",
      "body": [
        "pin",
        "displayName",
        "workspace",
        "lease"
      ],
      "reply": [
        "token",
        "clientId",
        "displayName",
        "revision",
        "role",
        "workspace"
      ]
    },
    {
      "method": "POST",
      "path": "/api/session/host",
      "body": [
        "displayName",
        "lease"
      ],
      "reply": [
        "token",
        "clientId",
        "workspace",
        "guestPin"
      ]
    },
    {
      "method": "POST",
      "path": "/api/workspaces/open",
      "query": [
        "token"
      ],
      "body": [
        "team",
        "path",
        "device",
        "lease",
        "version",
        "reason",
        "pageId",
        "uptimeMs"
      ],
      "reply": [
        "token",
        "clientId",
        "displayName",
        "revision",
        "role",
        "workspace"
      ]
    },
    {
      "method": "GET",
      "path": "/api/session/state",
      "query": [
        "token"
      ],
      "reply": [
        "project",
        "revision",
        "presence"
      ]
    },
    {
      "method": "POST",
      "path": "/api/session/state",
      "query": [
        "token"
      ],
      "body": [
        "project",
        "baseRevision",
        "version"
      ],
      "reply": [
        "revision"
      ]
    },
    {
      "method": "GET",
      "path": "/api/session/presence",
      "query": [
        "token"
      ],
      "reply": [
        "presence",
        "revision"
      ]
    },
    {
      "method": "POST",
      "path": "/api/session/presence",
      "query": [
        "token"
      ],
      "body": [
        "fileId",
        "selStart",
        "selEnd"
      ]
    },
    {
      "method": "POST",
      "path": "/api/session/lease",
      "query": [
        "token"
      ]
    },
    {
      "method": "POST",
      "path": "/api/session/leave",
      "query": [
        "token"
      ]
    },
    {
      "method": "POST",
      "path": "/api/operations",
      "query": [
        "token"
      ],
      "body": [
        "operation",
        "version"
      ],
      "reply": [
        "revision",
        "operation",
        "counters",
        "path"
      ]
    },
    {
      "method": "GET",
      "path": "/api/events/stream",
      "query": [
        "token",
        "lease"
      ],
      "stream": true
    },
    {
      "method": "GET",
      "path": "/api/workspaces/asset",
      "query": [
        "token",
        "path"
      ],
      "reply": "the file's bytes"
    },
    {
      "method": "POST",
      "path": "/api/workspaces/asset",
      "query": [
        "token",
        "path",
        "offset"
      ],
      "body": "the piece's bytes",
      "reply": [
        "ok",
        "size"
      ]
    }
  ],
  "operations": {
    "endpoint": "POST /api/operations",
    "types": [
      "create-file",
      "create-folder",
      "delete-node",
      "move-node",
      "patch-file",
      "rename-node",
      "replace-project",
      "update-file"
    ]
  },
  "events": {
    "endpoint": "GET /api/events/stream (server-sent events)",
    "types": [
      "cursor",
      "operation",
      "presence",
      "ready",
      "state"
    ]
  },
  "history": {
    "115": "tabs older than this never sent move-node, so a drag left the old path on the server and the next reconnect uploaded the file again",
    "116": "Roleplay group chats keep kind/members on threads and speaker on messages; older tabs dropped those fields",
    "117": "Chats replaced Roleplay; older tabs would keep writing Roleplay group threads into the shared chat"
  }
}
