{
  "about": "History's network messages (rule 7): snapshots of files and backups of whole workspaces. The server half serves exactly these routes (server/stilo/modules/history/adapters/routes.py); only the browser half (app/modules/history/adapters/api.js) calls them. Raise the version when a message changes in a way an older browser cannot read.",
  "module": "history",
  "version": 1,
  "routes": [
    { "method": "GET", "path": "/api/snapshots", "query": ["token", "team", "path"], "reply": ["paths", "bytes", "baselines"] },
    { "method": "GET", "path": "/api/snapshots/versions", "query": ["token", "team", "path", "file"], "reply": ["versions"] },
    { "method": "GET", "path": "/api/snapshots/content", "query": ["token", "team", "path", "id"], "reply": ["content", "file", "version"] },
    { "method": "POST", "path": "/api/snapshots", "query": ["token"], "body": ["team", "path", "file", "content", "label", "createdAt"], "reply": ["created", "version"] },
    { "method": "POST", "path": "/api/snapshots/delete", "query": ["token"], "body": ["team", "path", "id"], "reply": ["deleted"] },
    { "method": "GET", "path": "/api/backups", "query": ["token", "team", "path"], "reply": ["backups"] },
    { "method": "GET", "path": "/api/backups/files", "query": ["token", "team", "path", "id"], "reply": ["backup", "folders", "files"] },
    { "method": "GET", "path": "/api/backups/content", "query": ["token", "team", "path", "id", "file"], "reply": ["path", "image", "content"] },
    { "method": "POST", "path": "/api/backups", "query": ["token"], "body": ["team", "path", "label"], "reply": ["created", "backup"] }
  ]
}
