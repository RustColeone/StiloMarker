{
  "name": "stilo-marker",
  "productName": "Stilo Marker",
  "version": "0.3.0",
  "description": "A Markdown workspace: notes, diagrams, characters, writing together.",
  "author": "RustColeone",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.rustcoleone.stilomarker",
    "productName": "Stilo Marker",
    "files": [
      "main.mjs",
      "app.mjs",
      "context-menu.mjs",
      "policy.mjs",
      "preload.cjs",
      "server.mjs",
      "server-policy.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "stilo",
        "filter": [
          "index.html",
          "manifest.webmanifest",
          "app/**/*",
          "assets/**/*",
          "extensions/**/*",
          "vendor/**/*",
          "Template/**/*",
          "protocol/**/*",
          "server/MANUAL.md",
          "server/**/*.py",
          "server/**/module.json",
          "!**/__pycache__/**"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "../assets/icons/icon-512.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../assets/icons/icon-512.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "../assets/icons/icon-512.png"
    }
  }
}
