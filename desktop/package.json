{
  "name": "stilo-marker",
  "productName": "Stilo Marker",
  "version": "0.2.26",
  "description": "A Markdown workspace: notes, diagrams, characters, writing together.",
  "author": "RustColeone",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.rustcoleone.stilomarker",
    "productName": "Stilo Marker",
    "files": ["main.mjs", "app.mjs", "policy.mjs", "preload.cjs", "package.json"],
    "extraResources": [
      { "from": "../index.html", "to": "web/index.html" },
      { "from": "../manifest.webmanifest", "to": "web/manifest.webmanifest" },
      { "from": "../app", "to": "web/app" },
      { "from": "../assets", "to": "web/assets" },
      { "from": "../extensions", "to": "web/extensions", "filter": ["**/*", "!**/server/**", "!**/*.py"] },
      { "from": "../vendor", "to": "web/vendor" },
      { "from": "../Template", "to": "web/Template" }
    ],
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "icon": "../assets/icons/icon-512.png" },
    "win": { "target": ["nsis"], "icon": "../assets/icons/icon-512.png" },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity", "icon": "../assets/icons/icon-512.png" }
  }
}
